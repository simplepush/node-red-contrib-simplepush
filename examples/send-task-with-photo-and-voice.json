[{"id": "acc", "type": "simplepush-account", "name": "My account", "account": "personal"}, {"id": "cmt", "type": "comment", "z": "f1", "name": "Asks for a photo and a voice recording and saves both to /tmp/simplepush", "info": "", "x": 330, "y": 40, "wires": []}, {"id": "inj", "type": "inject", "z": "f1", "name": "", "props": [{"p": "payload"}], "repeat": "", "once": false, "topic": "", "payload": "Water on the basement floor, please check", "payloadType": "str", "x": 170, "y": 120, "wires": [["task"]]}, {"id": "task", "type": "simplepush", "z": "f1", "account": "acc", "topic": "home", "member": "", "broadcast": false, "title": "Basement", "message": "", "markdown": false, "tag": "", "priority": "", "expiresIn": "", "shared": false, "links": "", "attachments": "", "taskInputs": [{"type": "photo", "description": "Photo of the floor", "required": true}, {"type": "voiceRecording", "description": "Tell us what you see", "required": false}], "autoCommit": false, "name": "", "outputs": 4, "x": 430, "y": 120, "wires": [["files"], ["d2"], ["d2"], ["d2"]]}, {"id": "files", "type": "function", "z": "f1", "name": "photo and voice", "func": "// One message per file: the photo, and the voice recording if there is one.\nconst saved = [];\nfor (const key of [\"photo\", \"voice\"]) {\n    const file = msg.payload[key];\n    if (file && file.data) {\n        saved.push({ payload: file.data, filename: \"/tmp/simplepush/\" + file.id + \"-\" + (file.filename || key) });\n    }\n}\nreturn [saved];", "outputs": 1, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 640, "y": 100, "wires": [["save"]]}, {"id": "save", "type": "file", "z": "f1", "name": "", "filename": "filename", "filenameType": "msg", "appendNewline": false, "createDir": true, "overwriteFile": "true", "encoding": "none", "x": 830, "y": 100, "wires": [[]]}, {"id": "d2", "type": "debug", "z": "f1", "name": "no answer", "active": true, "tosidebar": true, "console": false, "complete": "true", "targetType": "full", "x": 650, "y": 160, "wires": []}]